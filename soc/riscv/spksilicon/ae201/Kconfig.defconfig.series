if SOC_SERIES_SPK32AE201X

config SOC_SERIES
	default "ae201"

# EC core clock 的 Hz 单一事实源 = dts 的 cpu0 clock-frequency（ae201.dts）。
# 主频 = 80M / FlashInfo.MainFrequency（分频数 div），div 由 clock-frequency 反推
# （见 ecfw-zephyr/misc/flash_info.h 的 FLASH_INFO_MAIN_FREQ_DEFAULT）。BootROM 按
# FlashInfo 配好 CLKDIV_OSC80M（硬件限制时 clamp，如 AE201N 型号最高 40M）。
# 改主频只改 dts 的 clock-frequency 一处（对齐 neorv32/niosv 的 dt_node_int_prop_int）。
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

config RISCV_GP
	default y

# NUM_IRQS = _sw_isr_table[] 的项数 = Zephyr 眼中的「中断号」上限。
#
# ⚠️ 104 是按「INTC0 源数 + INTC1 源数」推导的历史值，与手册不一致：
#    手册 v0.5.9 表 13-1 中 INTC0 是 59 源（GPIOA[31:0] + GPIOB[26:0]），
#    INTC1 声明 60 源但只列出 54 个（差额见 include/reg/ae201_intr_reg.h
#    的保留段）。更重要的事实是：**二级源根本不占 Zephyr 的中断号** ——
#    它们由 INTC 自己的分派器处理（src/platform/ae201_intr_dispatch.c），
#    Zephyr 只认识 INTC0 / INTC1 这两个 IRQC 位（30 / 31）。
#
#    故 IRQC 的编号空间实为 32（ID 0..31），104 让表偏大（832B vs 256B
#    的 .bss）但不影响功能：32..103 号永不使用。
#    改小属内存优化，需复核 arch_irq_enable() 的 `1 << irq` 与所有
#    IRQ_CONNECT 的编号，留待单独一次改动，不在模块落地时一并动。
config NUM_IRQS
	default 104

# AE201X 系列为单核 N100（mhartid 恒 0，仅单 Hart 集成），MP_MAX_NUM_CPUS
# 恒定为 1。在此 SoC/series 层固定默认值，客户在 board/应用层无需配置。
# （如需彻底锁定禁止改大，可追加 range 1 1；当前仅设 default，保留灵活性。）
config MP_MAX_NUM_CPUS
	default 1

config RISCV_SOC_INTERRUPT_INIT
	default y

endif # SOC_SERIES_SPK32AE201X
