config SOC_SERIES_SPK_AE201X
	bool "SPK AE201X series"
	select SOC_FAMILY_SPKSILICON
	help
	  SPK AE201X silicon series (formal name).
	  Internal test numbers/names were AE103 / AE103FM / AE103NTO; product SKUs
	  AE201E / AE201N / AE201X(TBD) are derived from the same silicon
	  via eFUSE configuration.
