config SOC_SERIES_SPK_AE103X
	bool "SPK AE103X series (AE201X)"
	select SOC_FAMILY_SPKSILICON
	help
	  SPK AE103 silicon series, formally named AE201X.
	  Internal test names are AE103 / AE103FM / AE103NTO; product SKUs
	  AE201E / AE201N / AE201X(TBD) are derived from the same silicon
	  via eFUSE configuration.
