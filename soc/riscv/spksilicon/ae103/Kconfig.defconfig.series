if SOC_SERIES_SPK_AE103X

config SOC_SERIES
	default "ae103"

# EC core clock. TODO: confirm against SYSCTL PLL config (48MHz default).
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 48000000

# INTC0 (64 sources) + INTC1 (40 sources).
config NUM_IRQS
	default 104

# AE103X 系列为单核 N100（mhartid 恒 0，仅单 Hart 集成），MP_MAX_NUM_CPUS
# 恒定为 1。在此 SoC/series 层固定默认值，客户在 board/应用层无需配置。
# （如需彻底锁定禁止改大，可追加 range 1 1；当前仅设 default，保留灵活性。）
config MP_MAX_NUM_CPUS
	default 1

config RISCV_SOC_INTERRUPT_INIT
	default y

endif # SOC_SERIES_SPK_AE103X
